#!/usr/bin/env bash

# ==============================================================================
# SIRAB SDN Sidokare 3 - Git Post-Merge Hook
# Otomatisasi sinkronisasi database, composer, dan frontend setelah git pull.
# Kompatibel untuk Windows (Git Bash / CMD / PowerShell) dan Linux/macOS.
# ==============================================================================

# ANSI Color Codes
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m' # No Color

echo ""
echo -e "${CYAN}${BOLD}╔══════════════════════════════════════════════════════════════════╗${NC}"
echo -e "${CYAN}${BOLD}║              SIRAB SDN SIDOKARE 3 - AUTO SYNC HOOK               ║${NC}"
echo -e "${CYAN}${BOLD}║                  (Post-Merge Automation Active)                  ║${NC}"
echo -e "${CYAN}${BOLD}╚══════════════════════════════════════════════════════════════════╝${NC}"
echo ""

# Tentukan range commit yang baru ditarik
if git rev-parse --verify ORIG_HEAD >/dev/null 2>&1; then
    RANGE="ORIG_HEAD HEAD"
else
    RANGE="HEAD@{1} HEAD"
fi

CHANGED_FILES=$(git diff-tree -r --name-only --no-commit-id $RANGE 2>/dev/null)

# ------------------------------------------------------------------------------
# 1. CEK PERUBAHAN DATABASE MIGRATIONS
# ------------------------------------------------------------------------------
if echo "$CHANGED_FILES" | grep -q "^database/migrations/"; then
    echo -e "${YELLOW}⚡ Terdeteksi migrasi database baru/diperbarui.${NC}"
    echo -e "   Menjalankan: ${BOLD}php artisan migrate --force${NC} ..."
    
    if php artisan migrate --force; then
        echo -e "${GREEN}✔ Database berhasil dimigrasi tanpa menghapus data lokal Anda.${NC}"
        
        # Jalankan seeder master data idempoten agar referensi terbaru selalu sinkron
        echo -e "   Memutakhirkan master data (${BOLD}php artisan db:seed --force${NC}) ..."
        php artisan db:seed --force >/dev/null 2>&1
        echo -e "${GREEN}✔ Master data (Divisi & Akun Default) termutakhirkan.${NC}"
    else
        echo -e "${RED}✘ GAGAL menjalankan migrasi database!${NC}"
        echo -e "${RED}  Silakan periksa log error di atas dan pastikan koneksi DB aktif.${NC}"
    fi
else
    echo -e "${GREEN}✔ Skema database sudah yang terbaru (tidak ada migrasi baru).${NC}"
fi

# ------------------------------------------------------------------------------
# 2. CEK PERUBAHAN COMPOSER (DEPENDENCIES PHP)
# ------------------------------------------------------------------------------
if echo "$CHANGED_FILES" | grep -q "composer.lock"; then
    echo ""
    echo -e "${YELLOW}⚡ Terdeteksi perubahan dependency PHP (composer.lock).${NC}"
    echo -e "   Menjalankan: ${BOLD}composer install --no-interaction --prefer-dist${NC} ..."
    
    if command -v composer >/dev/null 2>&1; then
        composer install --no-interaction --prefer-dist
    elif command -v composer.bat >/dev/null 2>&1; then
        composer.bat install --no-interaction --prefer-dist
    fi
    echo -e "${GREEN}✔ Paket composer berhasil diperbarui.${NC}"
fi

# ------------------------------------------------------------------------------
# 3. CEK PERUBAHAN FRONTEND (NPM / ASSETS)
# ------------------------------------------------------------------------------
if echo "$CHANGED_FILES" | grep -E -q "package\.json|package-lock\.json|resources/(css|js)/"; then
    echo ""
    echo -e "${YELLOW}⚡ Terdeteksi perubahan pada frontend/asset templates.${NC}"
    echo -e "   Mengompilasi aset: ${BOLD}npm run build${NC} ..."
    
    if command -v npm >/dev/null 2>&1; then
        npm run build
    elif command -v npm.cmd >/dev/null 2>&1; then
        npm.cmd run build
    fi
    echo -e "${GREEN}✔ Aset frontend berhasil dikompilasi.${NC}"
fi

# ------------------------------------------------------------------------------
# 4. CEK PERUBAHAN ENVIRONMENT (.env.example)
# ------------------------------------------------------------------------------
if echo "$CHANGED_FILES" | grep -q "\.env\.example"; then
    echo ""
    echo -e "${YELLOW}ℹ PERHATIAN: File .env.example telah diperbarui oleh tim.${NC}"
    echo -e "${YELLOW}  Bandingkan file .env lokal Anda untuk memastikan tidak ada kunci konfigurasi baru yang terlewat.${NC}"
fi

echo ""
echo -e "${GREEN}${BOLD}✔ Sinkronisasi selesai! Lingkungan kerja lokal Anda siap digunakan.${NC}"
echo ""
